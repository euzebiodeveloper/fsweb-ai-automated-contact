msgstr "Licença ativada com sucesso!"

msgid "The license server returned an invalid response. Your key was saved and is pending validation."
msgstr "O servidor de licenças respondeu de forma inválida. A chave foi salva e está pendente de validação."

msgid "Invalid license key."
msgstr "Chave de licença inválida."

msgid "License deactivated."
msgstr "Licença desativada."

msgid "No license saved. Enter a key first."
msgstr "Nenhuma licença salva. Informe uma chave primeiro."

msgid "Could not reach the license server."
msgstr "Não foi possível falar com o servidor de licenças."

msgid "Invalid response from the license server."
msgstr "Resposta inválida do servidor de licenças."

msgid "License is active and valid."
msgstr "Licença ativa e válida."

msgid "License expired. Renew it to keep receiving updates."
msgstr "Licença expirada. Renove para continuar recebendo atualizações."

msgid "License pending activation."
msgstr "Licença aguardando ativação."

msgid "License inactive."
msgstr "Licença inativa."

msgid "The license server returned an empty response."
msgstr "O servidor de licenças retornou uma resposta vazia."

msgid "The virtual assistant is not active in this store."
msgstr "O atendente virtual não está ativo nesta loja."

msgid "The virtual assistant is disabled."
msgstr "O atendente virtual está desativado."

